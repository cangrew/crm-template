# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (client-safe; exposed to the browser) ---
# Local dev values come from `pnpm exec supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key

# --- Supabase (server-only; NEVER expose to the browser) ---
# Privileged service-role key. Required by any server-side job that writes
# while bypassing RLS (e.g. future cron routes built on lib/cron/auth.ts).
# Local value comes from `pnpm exec supabase start`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Scheduled jobs (Vercel Cron) ---
# Shared secret Vercel sends as `Authorization: Bearer <CRON_SECRET>` when it
# triggers /api/cron/*. The template ships no cron routes, but the auth helper
# (lib/cron/auth.ts) is wired and ready; set the same value here and in the
# Vercel project settings when you add one.
CRON_SECRET=your-cron-secret

# --- Microsoft Entra ID (Azure AD) OAuth provider ---
# For LOCAL dev, the Supabase CLI reads these via supabase/config.toml
# ([auth.external.azure]). For hosted Supabase, set the provider in the
# dashboard (Authentication -> Providers -> Azure) instead of here.
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=your-entra-app-client-id
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=your-entra-app-client-secret
# Tenant-scoped issuer URL; replace <tenant-id> with your Entra tenant (GUID)
# to restrict logins to your organization.
SUPABASE_AUTH_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/<tenant-id>/v2.0

# --- Local dev role switcher ---
# When set to "1", the app shell auto-signs you in as the seeded admin on
# first load and shows a "DEV" pill in the topbar that flips between the
# admin, manager, and member seeded users. Has no effect in `next build`
# (gated on NODE_ENV === "development").
NEXT_PUBLIC_BYPASS_AUTH=1
